# Backblaze B2 (required) — S3-compatible API only
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only — the S3 endpoint is derived as https://s3.{B2_REGION}.backblazeb2.com
B2_REGION=your_region
# Optional public base URL for the bucket (used to build object URLs)
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K000fakefakefakefakefakefakefake
# B2_BUCKET_NAME=my-video-library
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-video-library.s3.us-west-004.backblazeb2.com

# --- Subtitle pipeline (faster-whisper, runs on-device) ---
# Model size: tiny | base | small | medium | large-v3
# `base` (~140 MB) is a fast default for a local demo; `large-v3` (~3 GB)
# is the production quality target. Weights download from Hugging Face on
# first use (Whisper models are public — no token required).
WHISPER_MODEL=base
# Device: auto | cpu | cuda  (auto picks CUDA when available, else CPU;
# CTranslate2 has no Apple-MPS backend, so Apple Silicon resolves to CPU)
WHISPER_DEVICE=auto
# Compute type: auto | int8 | float16 | float32  (auto = float16 on CUDA, int8 on CPU)
WHISPER_COMPUTE_TYPE=auto
# Background worker threads (single worker is plenty for a demo)
WHISPER_WORKER_THREADS=1
